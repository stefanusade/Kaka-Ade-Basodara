# CMS API — generate a fresh key from the CMS dashboard (cms.kakaadebasodara.com)
# Required: without it, protected post types (project/blog/product) throw 401
# and every content section shows an error state instead of data.
CMS_API_KEY=

# Optional — defaults below are used when unset:
# CMS_BASE_URL=https://cms.kakaadebasodara.com/api/v1
# NEXT_PUBLIC_CMS_MEDIA_URL=https://cms.kakaadebasodara.com/storage
# NEXT_PUBLIC_SITE_URL=https://kakaadebasodara.com

# Copy this file to .env.local and fill in the real values:
#   cp .env.example .env.local
# NEVER commit .env.local.
