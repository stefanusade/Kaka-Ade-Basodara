# CMS API — generate a fresh key from the CMS dashboard (cms.kakaadebasodara.com)
# Required: without it, protected post types (project/blog/product) throw 401
# and every content section shows an error state instead of data.
CMS_API_KEY=

# Optional — defaults below are used when unset:
# CMS_BASE_URL=https://cms.kakaadebasodara.com/api/v1
# NEXT_PUBLIC_CMS_MEDIA_URL=https://cms.kakaadebasodara.com/storage
# NEXT_PUBLIC_SITE_URL=https://kakaadebasodara.com

# Copy this file to .env.local and fill in the real values:
#   cp .env.example .env.local
# NEVER commit .env.local.

# Contact form — API key read/write KHUSUS content type `contact-form`
# Tanpa prefix NEXT_PUBLIC_: dipakai hanya di server (app/api/contact).
CMS_CONTACT_API_KEY=

# Cloudflare Turnstile untuk form kontak (buat widget di dash.cloudflare.com)
# Bila dikosongkan, form tetap berjalan tetapi verifikasi bot dilewati.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
